use Test;
use Redis;

use lib "t";
use Test::SpawnRedisServer;

plan 4;

if SpawnRedis() -> $proc {
    LEAVE $proc.kill('INT');

    my $r = Redis.new("127.0.0.1:63790", decode_response => True);
    $r.auth('20bdfc8e73365b2fde82d7b17c3e429a9a94c5c9');
    $r.flushall;

    my $value = 'x' x 500_000;
    $r.set("big", $value);
    is $r.get("big"), $value, 'large bulk reply';
    is-deeply $r.ping, True, 'in sync after large bulk reply';

    my @keys = (^500).map({ "many:$_" });
    $r.set($_, 'y' x 500) for @keys;
    is-deeply $r.mget(|@keys), ['y' x 500 xx 500], 'large multi-bulk reply';
    is-deeply $r.ping, True, 'in sync after large multi-bulk reply';
}
else {
    skip-rest "no redis-server";
}

